# Perfil ativo: dev | prod
SPRING_PROFILES_ACTIVE=dev

# Banco de dados
DATABASE_URL=jdbc:postgresql://localhost:5455/the_rogue_dev
DATABASE_NAME=the_rogue_dev
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
POSTGRES_PORT=5455

# JWT
SECRET=is_a_secret

# ImgBB
IMGBB_UPLOAD_URL=https://api.imgbb.com/1/upload?key=YOUR_KEY

# Google OAuth2
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret

# CORS (separar múltiplas origens por vírgula)
# Dev: definido diretamente no application-dev.yml (http://localhost:4200)
# Prod: obrigatório via variável de ambiente
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Porta do servidor (prod only, default 8080)
# SERVER_PORT=8080
